# ==============================================================================
# RLTSMS - RISEUP LABS TOOLS & SERVICES MANAGEMENT SYSTEM
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ('production' | 'development' | 'test')
NODE_ENV=production

# Server Network Settings
PORT=5000
HOST=0.0.0.0
APP_URL=https://rltsms.riseuplabs.com
CORS_ORIGIN=https://rltsms.riseuplabs.com

# Cryptographic Token & Session Security
JWT_SECRET=riseuplabs_rltsms_jwt_production_secret_key_change_me_in_production
SESSION_TIMEOUT_MINUTES=480

# ==============================================================================
# MySQL 8.4 LTS Database Connection
# ==============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=rltsms_db
MYSQL_USER=rltsms_user
MYSQL_PASSWORD=change_this_to_a_strong_password
MYSQL_CONNECTION_LIMIT=20
MYSQL_CONNECT_TIMEOUT_MS=10000

# ==============================================================================
# Enterprise Email & SMTP Integration (Part 10)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@riseuplabs.com
SMTP_PASS=app_specific_password_here
SMTP_FROM="Riseup Labs Tools & Services <notifications@riseuplabs.com>"
SUPPORT_EMAIL=support@riseuplabs.com

# ==============================================================================
# Rate Limiting & Zero-PAN Security Settings (Part 9)
# ==============================================================================
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
CARD_REVEAL_WINDOW_SECONDS=30
CARD_REVEAL_MAX_FAILED_ATTEMPTS=3

# Optional: Google Gemini AI API key for conversational agent enhancements
GEMINI_API_KEY=
